# =============================================================================
# Blockchain Voting System - Frontend Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in the actual values.
#
# SECURITY: Never commit your actual .env file to version control!
# =============================================================================

# --- Legacy Contract (PollFactory - Unsafe) ---
# This contract has a privacy leak: it stores `hasVoted[address]` on-chain.
# Only use for testing or non-critical polls.
REACT_APP_CONTRACT_ADDRESS=0x_YOUR_POLL_FACTORY_ADDRESS_HERE

# --- New ZK Contract (AnonymousVoting) ---
# This contract uses Semaphore v4 for zero-knowledge proof voting.
# Voter identity is never revealed on-chain.
REACT_APP_ANONYMOUS_VOTING_ADDRESS=0x_YOUR_ANONYMOUS_VOTING_ADDRESS_HERE

# --- Optional: Network Configuration ---
# REACT_APP_CHAIN_ID=11155111
# REACT_APP_RPC_URL=https://sepolia.infura.io/v3/YOUR_API_KEY
